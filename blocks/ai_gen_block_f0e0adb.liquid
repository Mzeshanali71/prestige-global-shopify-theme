{% doc %}
  @prompt
    Generate Editorial Hero Banner
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-hero-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-editorial-hero__media-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: {{ block.settings.content_alignment }};
    min-height: {{ block.settings.hero_height }}px;
    overflow: hidden;
    background: #e9e6e1;
    color: #ffffff;
  }

  .ai-editorial-hero__image-{{ ai_gen_id }},
  .ai-editorial-hero__placeholder-{{ ai_gen_id }},
  .ai-editorial-hero__shade-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ai-editorial-hero__image-{{ ai_gen_id }} {
    object-fit: cover;
    object-position: center;
  }

  .ai-editorial-hero__placeholder-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e9e6e1;
  }

  .ai-editorial-hero__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    color: #6b6259;
  }

  .ai-editorial-hero__empty-{{ ai_gen_id }} {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 12px;
    border-radius: 2px;
    background: #ffffff;
    color: #1a1a1a;
    font-size: 13px;
    text-align: center;
  }

  .ai-editorial-hero__shade-{{ ai_gen_id }} {
    background: rgba(0, 0, 0, {{ block.settings.overlay_strength | divided_by: 10.0 }});
    pointer-events: none;
  }

  .ai-editorial-hero__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    width: min(680px, calc(100% - 40px));
    padding: clamp(22px, 5vw, 52px);
    background: rgba(0, 0, 0, 0.62);
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-editorial-hero__eyebrow-{{ ai_gen_id }} {
    margin: 0 0 12px;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ai-editorial-hero__heading-{{ ai_gen_id }} {
    margin: 0;
    color: #ffffff;
    font-size: clamp(32px, 5vw, {{ block.settings.heading_size }}px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .ai-editorial-hero__description-{{ ai_gen_id }} {
    margin-top: 16px;
    color: #ffffff;
    font-size: 16px;
    line-height: 1.6;
  }

  .ai-editorial-hero__description-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-editorial-hero__cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    margin-top: 24px;
    padding: 12px 24px;
    border: 1px solid #ffffff;
    background: #ffffff;
    color: #1a1a1a;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .ai-editorial-hero__cta-{{ ai_gen_id }}:hover {
    background: transparent;
    color: #ffffff;
  }

  .ai-editorial-hero__cta-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-hero__media-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_height }}px;
    }

    .ai-editorial-hero__content-{{ ai_gen_id }} {
      width: calc(100% - 32px);
      padding: 24px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-editorial-hero__cta-{{ ai_gen_id }} {
      transition: none;
    }
  }
{% endstyle %}

<div class="ai-editorial-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-hero__media-{{ ai_gen_id }}">
    {% if block.settings.image != blank %}
      <img
        class="ai-editorial-hero__image-{{ ai_gen_id }}"
        src="{{ block.settings.image | image_url: width: 2400 }}"
        alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        loading="lazy"
      >
    {% else %}
      <div class="ai-editorial-hero__placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <span class="ai-editorial-hero__empty-{{ ai_gen_id }}">Add an image to complete your editorial hero</span>
      </div>
    {% endif %}
    <div class="ai-editorial-hero__shade-{{ ai_gen_id }}" aria-hidden="true"></div>
    <div class="ai-editorial-hero__content-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-editorial-hero__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h2 class="ai-editorial-hero__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-editorial-hero__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
      {% if block.settings.button_label != blank and block.settings.button_link != blank %}
        <a class="ai-editorial-hero__cta-{{ ai_gen_id }}" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The new collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A study in modern elegance"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Considered pieces, made to bring beauty to the everyday.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout and style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Desktop height",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 250,
      "max": 650,
      "step": 50,
      "unit": "px",
      "default": 450
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 36,
      "max": 72,
      "step": 3,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "overlay_strength",
      "label": "Image overlay strength",
      "min": 0,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content position",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Editorial hero banner"
    }
  ],
  "tag": null,
  "class": "editorial-hero-banner"
}
{% endschema %}