{% doc %}
  @prompt
    Generate Promotional Split Banner 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-split-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-promo-split__inner-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    overflow: hidden;
    min-height: 320px;
  }

  .ai-promo-split--image-right-{{ ai_gen_id }} .ai-promo-split__media-{{ ai_gen_id }} {
    order: 2;
  }

  .ai-promo-split__media-{{ ai_gen_id }} {
    position: relative;
    min-height: 320px;
    background: #f2f0ed;
  }

  .ai-promo-split__media-{{ ai_gen_id }} img,
  .ai-promo-split__placeholder-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
  }

  .ai-promo-split__placeholder-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
  }

  .ai-promo-split__placeholder-{{ ai_gen_id }} svg {
    color: #777;
  }

  .ai-promo-split__empty-{{ ai_gen_id }} {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.94);
    color: #333;
    font-size: 13px;
    text-align: center;
  }

  .ai-promo-split__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 18px;
    padding: clamp(28px, 6vw, 76px);
  }

  .ai-promo-split__eyebrow-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ai-promo-split__heading-{{ ai_gen_id }} {
    margin: 0;
    color: inherit;
    font-size: clamp(30px, 4vw, {{ block.settings.heading_size }}px);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .ai-promo-split__description-{{ ai_gen_id }} {
    max-width: 42ch;
    font-size: 16px;
    line-height: 1.65;
  }

  .ai-promo-split__description-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-promo-split__button-{{ ai_gen_id }} {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 48px;
    padding: 12px 24px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: 0;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: opacity 160ms ease;
  }

  .ai-promo-split__button-{{ ai_gen_id }}:hover {
    opacity: 0.84;
  }

  .ai-promo-split__button-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-promo-split-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-promo-split__inner-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-promo-split--image-right-{{ ai_gen_id }} .ai-promo-split__media-{{ ai_gen_id }} {
      order: 0;
    }

    .ai-promo-split__media-{{ ai_gen_id }},
    .ai-promo-split__media-{{ ai_gen_id }} img,
    .ai-promo-split__placeholder-{{ ai_gen_id }} svg {
      min-height: 240px;
      height: 240px;
    }

    .ai-promo-split__content-{{ ai_gen_id }} {
      gap: 14px;
      padding: 30px 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-promo-split__button-{{ ai_gen_id }} {
      transition: none;
    }
  }
{% endstyle %}

<div class="ai-promo-split-{{ ai_gen_id }} {% if block.settings.image_position == 'right' %}ai-promo-split--image-right-{{ ai_gen_id }}{% endif %}" {{ block.shopify_attributes }}>
  <div class="ai-promo-split__inner-{{ ai_gen_id }}">
    <div class="ai-promo-split__media-{{ ai_gen_id }}">
      {% if block.settings.image != blank %}
        <img
          src="{{ block.settings.image | image_url: width: 1600 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      {% else %}
        <div class="ai-promo-split__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-promo-split__empty-{{ ai_gen_id }}">Add an image to complete your promotional banner.</div>
        </div>
      {% endif %}
    </div>
    <div class="ai-promo-split__content-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-promo-split__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h2 class="ai-promo-split__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-promo-split__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
      {% if block.settings.button_label != blank and block.settings.button_link != blank %}
        <a class="ai-promo-split__button-{{ ai_gen_id }}" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Promotional split banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A little something special"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make room for something new"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover thoughtfully selected pieces made to bring a fresh perspective to your everyday.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 32,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#7A3E32"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Promotional split banner"
    }
  ],
  "tag": null,
  "class": "promotional-split-banner"
}
{% endschema %}