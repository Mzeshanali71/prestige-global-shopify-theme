{% doc %}
  @prompt
    Generate Curated Category Grid below Editorial Hero Banner
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-curated-grid-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;padding:{{ block.settings.padding_y }}px 0;color:{{ block.settings.text_color }};background:{{ block.settings.background_color }}}
.ai-curated-grid-{{ ai_gen_id }}__inner{width:100%;padding:0 24px;box-sizing:border-box}
.ai-curated-grid-{{ ai_gen_id }}__header{text-align:{{ block.settings.alignment }};margin:0 auto 28px}
.ai-curated-grid-{{ ai_gen_id }}__eyebrow{display:block;margin-bottom:8px;font-size:11px;line-height:1.4;letter-spacing:.16em;text-transform:uppercase}
.ai-curated-grid-{{ ai_gen_id }}__title{margin:0;color:{{ block.settings.text_color }};font-size:clamp(26px,3vw,{{ block.settings.heading_size }}px);line-height:1.15;font-weight:500}
.ai-curated-grid-{{ ai_gen_id }}__description{margin:12px auto 0;max-width:620px;font-size:15px;line-height:1.6}
.ai-curated-grid-{{ ai_gen_id }}__items{display:grid;grid-template-columns:repeat({{ block.settings.columns_desktop }},minmax(0,1fr));gap:{{ block.settings.gap }}px}
.ai-curated-grid-{{ ai_gen_id }}__card{display:block;color:inherit;text-decoration:none}
.ai-curated-grid-{{ ai_gen_id }}__media{position:relative;display:block;overflow:hidden;background:#f3f3f1;aspect-ratio:4/5}
.ai-curated-grid-{{ ai_gen_id }}__media img,.ai-curated-grid-{{ ai_gen_id }}__media svg{display:block;width:100%;height:100%;object-fit:cover;transition:transform .35s ease}
.ai-curated-grid-{{ ai_gen_id }}__card:hover .ai-curated-grid-{{ ai_gen_id }}__media img{transform:scale(1.03)}
.ai-curated-grid-{{ ai_gen_id }}__placeholder{display:block;position:relative;width:100%;height:100%}
.ai-curated-grid-{{ ai_gen_id }}__empty{position:absolute;left:12px;right:12px;bottom:12px;padding:8px 10px;color:#333;background:rgba(255,255,255,.94);text-align:center;font-size:12px;line-height:1.4}
.ai-curated-grid-{{ ai_gen_id }}__label{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:14px;font-size:15px;line-height:1.4;font-weight:500}
.ai-curated-grid-{{ ai_gen_id }}__arrow{flex:0 0 auto;font-size:18px;line-height:1}
.ai-curated-grid-{{ ai_gen_id }}__card:focus-visible{outline:2px solid currentColor;outline-offset:4px}
@media(max-width:749px){.ai-curated-grid-{{ ai_gen_id }}__inner{padding:0 16px}.ai-curated-grid-{{ ai_gen_id }}__items{grid-template-columns:repeat({{ block.settings.columns_mobile }},minmax(0,1fr));gap:{{ block.settings.mobile_gap }}px}.ai-curated-grid-{{ ai_gen_id }}__header{margin-bottom:20px}.ai-curated-grid-{{ ai_gen_id }}__label{padding-top:10px;font-size:14px}}
@media(prefers-reduced-motion:reduce){.ai-curated-grid-{{ ai_gen_id }}__media img{transition:none}}
{% endstyle %}
<div class="ai-curated-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-curated-grid-{{ ai_gen_id }}__inner">
{% if block.settings.heading != blank or block.settings.eyebrow != blank or block.settings.description != blank %}<div class="ai-curated-grid-{{ ai_gen_id }}__header">{% if block.settings.eyebrow != blank %}<span class="ai-curated-grid-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</span>{% endif %}{% if block.settings.heading != blank %}<h2 class="ai-curated-grid-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.description != blank %}<div class="ai-curated-grid-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>{% endif %}</div>{% endif %}
<div class="ai-curated-grid-{{ ai_gen_id }}__items">{% for i in (1..6) %}{% liquid
assign enabled_key = 'category_' | append: i | append: '_enabled'
assign image_key = 'category_' | append: i | append: '_image'
assign title_key = 'category_' | append: i | append: '_title'
assign collection_key = 'category_' | append: i | append: '_collection'
assign enabled = block.settings[enabled_key]
assign image = block.settings[image_key]
assign title = block.settings[title_key]
assign collection = block.settings[collection_key]
%}{% if enabled %}{% assign card_title = title %}{% if card_title == blank and collection != blank %}{% assign card_title = collection.title %}{% endif %}{% if card_title == blank %}{% assign card_title = 'Explore category' %}{% endif %}<a class="ai-curated-grid-{{ ai_gen_id }}__card" href="{% if collection != blank %}{{ collection.url }}{% else %}#{% endif %}" aria-label="{{ card_title | escape }}"><span class="ai-curated-grid-{{ ai_gen_id }}__media">{% if image != blank %}<img src="{{ image | image_url: width: 1000 }}" alt="{{ image.alt | default: card_title | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">{% elsif collection != blank and collection.featured_image != blank %}<img src="{{ collection.featured_image | image_url: width: 1000 }}" alt="{{ collection.featured_image.alt | default: card_title | escape }}" loading="lazy" width="{{ collection.featured_image.width }}" height="{{ collection.featured_image.height }}">{% else %}<span class="ai-curated-grid-{{ ai_gen_id }}__placeholder">{{ 'collection-apparel-1' | placeholder_svg_tag }}<span class="ai-curated-grid-{{ ai_gen_id }}__empty">Add a collection or choose an image</span></span>{% endif %}</span><span class="ai-curated-grid-{{ ai_gen_id }}__label"><span>{{ card_title | escape }}</span><span class="ai-curated-grid-{{ ai_gen_id }}__arrow" aria-hidden="true">→</span></span></a>{% endif %}{% endfor %}</div></div></div>
{% schema %}
{"name":"Curated category grid","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"DISCOVER THE EDIT"},{"type":"text","id":"heading","label":"Heading","default":"Curated for you"},{"type":"richtext","id":"description","label":"Description","default":"<p>Explore considered collections, selected to inspire your next look.</p>"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"select","id":"columns_desktop","label":"Columns on desktop","options":[{"value":"3","label":"3"},{"value":"4","label":"4"},{"value":"5","label":"5"}],"default":"3"},{"type":"select","id":"columns_mobile","label":"Columns on mobile","options":[{"value":"1","label":"1"},{"value":"2","label":"2"}],"default":"2"},{"type":"range","id":"gap","label":"Desktop gap","min":8,"max":40,"step":4,"unit":"px","default":20},{"type":"range","id":"mobile_gap","label":"Mobile gap","min":4,"max":24,"step":2,"unit":"px","default":12},{"type":"range","id":"padding_y","label":"Vertical spacing","min":0,"max":80,"step":5,"unit":"px","default":30},{"type":"range","id":"heading_size","label":"Heading size","min":24,"max":52,"step":2,"unit":"px","default":36},{"type":"select","id":"alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"left"},{"type":"color","id":"background_color","label":"Background","default":"#FFFFFF"},{"type":"color","id":"text_color","label":"Text","default":"#1A1A1A"},{"type":"header","content":"Categories"},{"type":"checkbox","id":"category_1_enabled","label":"Show category 1","default":true},{"type":"text","id":"category_1_title","label":"Category 1 title","default":"New arrivals"},{"type":"collection","id":"category_1_collection","label":"Category 1 collection"},{"type":"image_picker","id":"category_1_image","label":"Category 1 image"},{"type":"checkbox","id":"category_2_enabled","label":"Show category 2","default":true},{"type":"text","id":"category_2_title","label":"Category 2 title","default":"Best sellers"},{"type":"collection","id":"category_2_collection","label":"Category 2 collection"},{"type":"image_picker","id":"category_2_image","label":"Category 2 image"},{"type":"checkbox","id":"category_3_enabled","label":"Show category 3","default":true},{"type":"text","id":"category_3_title","label":"Category 3 title","default":"Clothing"},{"type":"collection","id":"category_3_collection","label":"Category 3 collection"},{"type":"image_picker","id":"category_3_image","label":"Category 3 image"},{"type":"checkbox","id":"category_4_enabled","label":"Show category 4","default":false},{"type":"text","id":"category_4_title","label":"Category 4 title","default":"Accessories"},{"type":"collection","id":"category_4_collection","label":"Category 4 collection"},{"type":"image_picker","id":"category_4_image","label":"Category 4 image"},{"type":"checkbox","id":"category_5_enabled","label":"Show category 5","default":false},{"type":"text","id":"category_5_title","label":"Category 5 title","default":"Featured"},{"type":"collection","id":"category_5_collection","label":"Category 5 collection"},{"type":"image_picker","id":"category_5_image","label":"Category 5 image"},{"type":"checkbox","id":"category_6_enabled","label":"Show category 6","default":false},{"type":"text","id":"category_6_title","label":"Category 6 title","default":"More to explore"},{"type":"collection","id":"category_6_collection","label":"Category 6 collection"},{"type":"image_picker","id":"category_6_image","label":"Category 6 image"}],"presets":[{"name":"Curated category grid"}],"tag":null,"class":"curated-category-grid"} {% endschema %}