{% doc %}
  @prompt
    Generate Editorial Hero Banner, Generate Curated Category Grid
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    color: #1A1A1A;
    background: #FFFFFF;
  }

  .ai-category-grid__inner-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-category-grid__header-{{ ai_gen_id }} {
    margin-bottom: 28px;
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-category-grid__heading-{{ ai_gen_id }} {
    margin: 0;
    color: #1A1A1A;
    font-size: clamp(24px, 3vw, {{ block.settings.heading_size }}px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .ai-category-grid__intro-{{ ai_gen_id }} {
    max-width: 620px;
    margin: 12px auto 0;
    color: #1A1A1A;
    font-size: 15px;
    line-height: 1.6;
  }

  .ai-category-grid__intro-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-category-grid__items-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-category-grid__card-{{ ai_gen_id }} {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .ai-category-grid__media-{{ ai_gen_id }} {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #f2f0ed;
  }

  .ai-category-grid__media-{{ ai_gen_id }} img,
  .ai-category-grid__media-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 250ms ease;
  }

  .ai-category-grid__card-{{ ai_gen_id }}:hover .ai-category-grid__media-{{ ai_gen_id }} img {
    transform: scale(1.03);
  }

  .ai-category-grid__card-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid #1A1A1A;
    outline-offset: 4px;
  }

  .ai-category-grid__title-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 14px 0 0;
    color: #1A1A1A;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
  }

  .ai-category-grid__arrow-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
  }

  .ai-category-grid__empty-{{ ai_gen_id }} {
    grid-column: 1 / -1;
    padding: 28px 20px;
    background: #f2f0ed;
    color: #1A1A1A;
    text-align: center;
    font-size: 14px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-category-grid-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding }}px 0;
    }

    .ai-category-grid__items-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-category-grid__header-{{ ai_gen_id }} {
      margin-bottom: 20px;
    }

    .ai-category-grid__title-{{ ai_gen_id }} {
      margin-top: 10px;
      font-size: 14px;
    }

    .ai-category-grid__arrow-{{ ai_gen_id }} {
      width: 16px;
      height: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-category-grid__media-{{ ai_gen_id }} img,
    .ai-category-grid__media-{{ ai_gen_id }} svg {
      transition: none;
    }
  }
{% endstyle %}

<div class="ai-category-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-grid__inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.intro != blank %}
      <div class="ai-category-grid__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-category-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
        {% endif %}
        {% if block.settings.intro != blank %}
          <div class="ai-category-grid__intro-{{ ai_gen_id }}">{{ block.settings.intro }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-category-grid__items-{{ ai_gen_id }}">
      {% if block.settings.collections != blank %}
        {% for collection in block.settings.collections %}
          <a class="ai-category-grid__card-{{ ai_gen_id }}" href="{{ collection.url }}" aria-label="{{ collection.title | escape }}">
            <span class="ai-category-grid__media-{{ ai_gen_id }}">
              {% if collection.image != blank %}
                <img
                  src="{{ collection.image | image_url: width: 1000 }}"
                  alt="{{ collection.image.alt | default: collection.title | escape }}"
                  width="{{ collection.image.width }}"
                  height="{{ collection.image.height }}"
                  loading="lazy"
                >
              {% else %}
                <span class="ai-category-grid__placeholder-{{ ai_gen_id }}">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                </span>
              {% endif %}
            </span>
            <span class="ai-category-grid__title-{{ ai_gen_id }}">
              <span>{{ collection.title | escape }}</span>
              <svg class="ai-category-grid__arrow-{{ ai_gen_id }}" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M3.5 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        {% endfor %}
      {% else %}
        <div class="ai-category-grid__empty-{{ ai_gen_id }}">Choose collections in the block settings to curate this category grid.</div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Curated category grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore our collections"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Discover thoughtfully curated pieces for every occasion.</p>"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 8
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Desktop gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Desktop vertical padding",
      "min": 0,
      "max": 80,
      "step": 8,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile vertical padding",
      "min": 0,
      "max": 48,
      "step": 6,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Curated category grid"
    }
  ],
  "tag": null,
  "class": "curated-category-grid"
}
{% endschema %}