<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ page_title }} | {{ shop.name }}</title>
  {{ content_for_header }}
  {{ 'prestige-global.css' | asset_url | stylesheet_tag }}
</head>
<body>

  <div class="announcement-bar">
    Complimentary Express DHL Delivery to the US & UK on Orders Over $150 / £120
  </div>

  <header class="site-header">
    <div class="container header-inner">
      <a href="{{ routes.root_url }}" class="site-logo">{{ shop.name | default: 'PRESTIGE' }}</a>

      <nav class="main-nav">
        <div class="nav-item">
          <a href="/collections/for-women">For Women</a>
          <div class="mega-dropdown">
            <div class="container mega-grid">
              <div class="mega-col">
                <h4>Clothing & Apparel</h4>
                <ul>
                  <li><a href="/collections/evening-occasionwear">Evening & Occasionwear</a></li>
                  <li><a href="/collections/tailoring-blazers">Tailoring & Blazers</a></li>
                  <li><a href="/collections/knitwear-cashmere">Knitwear & Cashmere</a></li>
                  <li><a href="/collections/luxury-pret-sets">Luxury Pret & Sets</a></li>
                  <li><a href="/collections/outerwear-trench-coats">Outerwear & Trench Coats</a></li>
                </ul>
              </div>
              <div class="mega-col">
                <h4>Handbags</h4>
                <ul>
                  <li><a href="/collections/structured-everyday-totes">Structured Everyday Totes</a></li>
                  <li><a href="/collections/shoulder-crossbody-bags">Shoulder & Crossbody Bags</a></li>
                  <li><a href="/collections/evening-clutches-minaudieres">Evening Clutches & Minaudières</a></li>
                  <li><a href="/collections/bucket-hobo-bags">Bucket & Hobo Bags</a></li>
                  <li><a href="/collections/mini-vanity-bags">Mini & Vanity Bags</a></li>
                </ul>
              </div>
              <div class="mega-col">
                <h4>Footwear</h4>
                <ul>
                  <li><a href="/collections/pointed-toe-pumps-heels">Pointed-Toe Pumps & Heels</a></li>
                  <li><a href="/collections/leather-loafers-mules">Leather Loafers & Mules</a></li>
                  <li><a href="/collections/ankle-chelsea-boots">Ankle & Chelsea Boots</a></li>
                  <li><a href="/collections/strappy-sandals">Strappy Sandals</a></li>
                  <li><a href="/collections/statement-boots">Statement Boots</a></li>
                </ul>
              </div>
              <div class="mega-col">
                <img src="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=600&q=80" alt="Women Editorial" style="width:100%; height:220px; object-fit:cover;">
              </div>
            </div>
          </div>
        </div>

        <div class="nav-item">
          <a href="/collections/for-men">For Men</a>
          <div class="mega-dropdown">
            <div class="container mega-grid">
              <div class="mega-col">
                <h4>Clothing & Apparel</h4>
                <ul>
                  <li><a href="/collections/bespoke-suits-tailoring">Bespoke Suits & Tailoring</a></li>
                  <li><a href="/collections/crisp-dress-shirts">Crisp Dress Shirts</a></li>
                  <li><a href="/collections/knitwear-polos">Knitwear & Polos</a></li>
                  <li><a href="/collections/trousers-chinos">Trousers & Chinos</a></li>
                  <li><a href="/collections/winter-outerwear">Winter Outerwear</a></li>
                </ul>
              </div>
              <div class="mega-col">
                <h4>Footwear</h4>
                <ul>
                  <li><a href="/collections/oxford-derby-shoes">Oxford & Derby Shoes</a></li>
                  <li><a href="/collections/chelsea-dress-boots">Chelsea & Dress Boots</a></li>
                  <li><a href="/collections/minimalist-leather-sneakers">Minimalist Leather Sneakers</a></li>
                  <li><a href="/collections/loafers-driving-shoes">Loafers & Driving Shoes</a></li>
                  <li><a href="/collections/winter-weather-boots">Winter Weather Boots</a></li>
                </ul>
              </div>
              <div class="mega-col">
                <h4>Accessories</h4>
                <ul>
                  <li><a href="/collections/executive-briefcases-portfolios">Executive Briefcases & Portfolios</a></li>
                  <li><a href="/collections/duffle-weekender-bags">Duffle & Weekender Bags</a></li>
                  <li><a href="/collections/belts-leather-wallets">Belts & Leather Wallets</a></li>
                  <li><a href="/collections/silk-ties-pocket-squares">Silk Ties & Pocket Squares</a></li>
                  <li><a href="/collections/cold-weather-essentials">Cold-Weather Essentials</a></li>
                </ul>
              </div>
              <div class="mega-col">
                <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&fit=crop&w=600&q=80" alt="Men Editorial" style="width:100%; height:220px; object-fit:cover;">
              </div>
            </div>
          </div>
        </div>

        <div class="nav-item"><a href="/collections/all">New Arrivals</a></div>
        <div class="nav-item sale-link"><a href="/collections/sale">Seasonal Sale</a></div>
      </nav>

      <div style="display:flex; gap:20px; align-items:center; font-size:12px; letter-spacing:1px;">
        <a href="{{ routes.search_url }}">SEARCH</a>
        <a href="{{ routes.account_url }}">ACCOUNT</a>
        <a href="{{ routes.cart_url }}">BAG ({{ cart.item_count }})</a>
      </div>
    </div>
  </header>

  <main role="main">
    {{ content_for_layout }}
  </main>

  {% section 'trust-footer' %}

</body>
</html>