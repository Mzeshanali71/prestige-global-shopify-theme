<footer style="background:#FFFFFF; border-top:1px solid #E5E5E5; margin-top:60px;">
  <div class="container" style="padding-top:48px; padding-bottom:48px; border-bottom:1px solid #E5E5E5;">
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap:32px; text-align:center;">
      <div>
        <h4 style="font-size:12px; letter-spacing:1.5px; text-transform:uppercase; margin-bottom:8px;">Express DHL Global Shipping</h4>
        <p style="font-size:12px; color:#666666;">3–5 Business Days to the US & UK</p>
      </div>
      <div>
        <h4 style="font-size:12px; letter-spacing:1.5px; text-transform:uppercase; margin-bottom:8px;">Secure Multi-Currency Checkout</h4>
        <p style="font-size:12px; color:#666666;">Shop seamlessly in USD ($) & GBP (£)</p>
      </div>
      <div>
        <h4 style="font-size:12px; letter-spacing:1.5px; text-transform:uppercase; margin-bottom:8px;">30-Day Hassle-Free Returns</h4>
        <p style="font-size:12px; color:#666666;">Easy international exchanges & refunds</p>
      </div>
    </div>
  </div>

  <div class="container" style="padding:32px; text-align:center; font-size:11px; color:#666666; letter-spacing:1px; text-transform:uppercase;">
    &copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: 'PRESTIGE GLOBAL' }}. All Rights Reserved.
  </div>
</footer>

{% schema %}
{
  "name": "Trust & Global Footer",
  "settings": []
}
{% endschema %}